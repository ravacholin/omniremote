<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#202124" android:paddingHorizontal="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/quick_volume_down" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:orientation="vertical" android:contentDescription="@string/quick_volume_down_desc" android:focusable="true" android:importantForAccessibility="yes">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_quick_volume_down" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/quick_play_pause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:orientation="vertical" android:contentDescription="@string/quick_play_pause_desc" android:focusable="true" android:importantForAccessibility="yes">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_quick_play_pause" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/quick_volume_up" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:orientation="vertical" android:contentDescription="@string/quick_volume_up_desc" android:focusable="true" android:importantForAccessibility="yes">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_quick_volume_up" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/quick_close" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:orientation="vertical" android:contentDescription="@string/quick_close_desc" android:focusable="true" android:importantForAccessibility="yes">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_quick_close" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
